<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.zhangdx</groupId>
    <artifactId>zhangdx-develop-tool</artifactId>
    <version>1.0-RELEASE</version>
    <packaging>pom</packaging>

    <name>zhangdx-develop-tool</name>
    <url>https://github.com/ZDX3987/zhangdx-develop-tool</url>
    <description>A personal Java program tool</description>
    <modules>
        <module>common-support</module>
        <module>search-engine-core</module>
        <module>search-engine-spring-boot3-starter</module>
        <module>file-upload-server</module>
        <module>file-upload-spring-boot3-starter</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <spring-boot.version>3.2.12</spring-boot.version>
        <spring.version>6.1.15</spring.version>
        <oss.version>3.18.3</oss.version>
        <webp-imageio.version>0.3.3</webp-imageio.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-web</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <!-- Spring Boot 自动配置核心 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-autoconfigure</artifactId>
                <version>${spring-boot.version}</version>
                <optional>true</optional>
            </dependency>
            <!-- 配置元数据生成（推荐） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring-boot.version}</version>
                <optional>true</optional>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>com.meilisearch.sdk</groupId>
                <artifactId>meilisearch-java</artifactId>
                <version>0.20.1</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.46</version>
                <optional>true</optional>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>3.8.1</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>1.2.83</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${oss.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.darkxanter</groupId>
                <artifactId>webp-imageio</artifactId>
                <version>${webp-imageio.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.zhangdx</groupId>
                <artifactId>common-support</artifactId>
                <version>1.0-RELEASE</version>
            </dependency>
            <dependency>
                <groupId>cn.zhangdx</groupId>
                <artifactId>search-engine-core</artifactId>
                <version>1.0.1-RELEASE</version>
            </dependency>
            <dependency>
                <groupId>cn.zhangdx</groupId>
                <artifactId>file-upload-server</artifactId>
                <version>1.0.1-RELEASE</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
